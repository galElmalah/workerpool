{
  "name": "@cadence/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787 --ip 127.0.0.1",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@cadence/core": "workspace:*",
    "@cadence/garmin": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "d3-array": "3.2.5",
    "d3-interpolate-path": "2.3.0",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.19",
    "lucide-react": "1.77.0",
    "maplibre-gl": "6.16.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-array": "3.2.2",
    "@types/d3-interpolate-path": "2.0.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
